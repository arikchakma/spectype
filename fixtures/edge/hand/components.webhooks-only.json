{
  "openapi": "3.1.0",
  "info": {
    "title": "edge",
    "version": "1.0.0"
  },
  "webhooks": {
    "newPet": {
      "post": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Pet"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "pet.updated": {
      "$ref": "#/components/pathItems/Hook"
    },
    "weird name/with slash": {
      "put": {
        "responses": {
          "204": {
            "description": "x"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Pet": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          }
        }
      }
    },
    "pathItems": {
      "Hook": {
        "post": {
          "operationId": "petUpdatedHook",
          "responses": {
            "200": {
              "description": "ok"
            }
          }
        }
      }
    }
  }
}
